# Copy to .env for a real model run. demo_homework.py does not need this file.
# Use your own key locally. Never commit .env.
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_MODEL=gpt-4o-mini
# Optional endpoint for an OpenAI-compatible model gateway (include /v1).
# OPENAI_BASE_URL=https://your-gateway.example/v1
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=90

# This list overrides legacy DATABASE_* single-database settings.
# These credentials are PUBLIC demo credentials, for the localhost fixture only.
DATABASES=[{"name":"homework_sales","host":"127.0.0.1","port":55439,"user":"homework_reader","password":"homework-reader-demo","min_pool_size":1,"max_pool_size":3},{"name":"homework_archive","host":"127.0.0.1","port":55439,"user":"homework_reader","password":"homework-reader-demo","min_pool_size":1,"max_pool_size":3}]

SECURITY_BLOCKED_TABLES=["public.audit_log"]
SECURITY_BLOCKED_COLUMNS=["users.password"]
SECURITY_ALLOW_EXPLAIN=false
SECURITY_ALLOW_WRITE_OPERATIONS=false
SECURITY_MAX_ROWS=100
SECURITY_MAX_EXECUTION_TIME=10

RESILIENCE_QUERY_CONCURRENCY=10
RESILIENCE_LLM_CONCURRENCY=5
RESILIENCE_QUEUE_TIMEOUT=5
RESILIENCE_MAX_RETRIES=2
RESILIENCE_RETRY_DELAY=0.5
RESILIENCE_BACKOFF_FACTOR=2
RESILIENCE_MAX_RETRY_DELAY=5

VALIDATION_ENABLED=false
VALIDATION_MAX_QUESTION_LENGTH=2000
CACHE_ENABLED=true
CACHE_MAX_SIZE=100
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_PORT=19139
OBSERVABILITY_LOG_FORMAT=json
OBSERVABILITY_LOG_LEVEL=INFO
